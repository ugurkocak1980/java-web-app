pipeline {
  agent { label 'linux' }
  options {
    buildDiscarder(logRotator(numToKeepStr: '5'))
  }
  stages {
    stage('Build') {
      steps {
        sh 'docker build -t ugurkocak1980/java-web-app:latest .'
      }
    }
    stage('Scan') {
      steps {
        //sh 'trivy image ugurkocak1980/java-web-app:latest'
        sh 'trivy image alpine:3.10'
      }
    }
  }
}